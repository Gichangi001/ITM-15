# Copy to .env.local for local development. Never commit real values.
# See docs/PRODUCT_GUIDE.md §31 and docs/claude/ENVIRONMENT_INVENTORY.md for context.

# --- Public (safe to bundle into client JS) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only (never expose to the browser; validated in src/lib/env.server.ts) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# --- Direct Postgres access (only needed if/when an ORM or raw SQL tooling
# is adopted — not currently required by the app; see docs/PROJECT_STATE.md
# for the open question on whether Prisma is added at all) ---
DATABASE_URL=
DIRECT_URL=

# --- Not yet wired up ---
RESEND_API_KEY=
EMAIL_FROM=
CRON_SECRET=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
